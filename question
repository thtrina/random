###############################################################################################################################
# REMOTE NEW HIRE
###############################################################################################################################

if ($rclo -match '(?i)^((H|R)[0-9]{3}|OFSH|OFSI)$') {

    writeToLog("Setting mail body and params for remote new hire")

    $body = @"
    
YOUR EXISTING REMOTE NEW HIRE EMAIL BODY GOES HERE

"@

    # Keep your existing recipient
    # $to = "somebody"
    $to = "somebody"


    $tofinal = @($to) |
        Where-Object {
            -not [string]::IsNullOrWhiteSpace($_)
        } |
        Select-Object -Unique


    $subject = "Sandbox-Active Directory account password for remote new hire $displayName"


    $splat = @{
        UseSsl     = $true
        SMTPServer = $smtpServer
        From       = $from
        To         = $tofinal
        Subject    = $subject
        Body       = $body
        BodyAsHtml = $true
    }


    writeToLog("Email type: Remote New Hire")
    writeToLog("Email recipient: $to")
    writeToLog("Email subject: $subject")
    writeToLog("Sending email")


    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }


    if (-not [string]::IsNullOrWhiteSpace($to)) {

        try {

            Send-MailMessage @splat

            writeToLog(
                "SUCCESS: Password set and email sent to $to for account $nativeIdentity."
            )

        }
        catch {

            writeToLog(
                "ERROR: Failed to send remote new hire email."
            )

            writeToLog(
                "ERROR: $($_.Exception.Message)"
            )

            throw
        }

    }
    else {

        writeToLog(
            "WARNING: Manager email is null or empty. Email not sent."
        )

    }

}


