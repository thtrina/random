if ($rclo -match '(?i)^((H|R)[0-9]{3}|OFSH|OFSI)$') {
		writeToLog("Setting mail body and params for remote new hire")
		
		$body = @"

"@
        #$to = "somebody"
        $to = "somebody"

        $tofinal = @($to) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique  #List of all reciepient email addresses
    
        $subject = "Sandbox-Active Directory account password for remote new hire $displayName"
            
        $splat = @{
            UseSsl     = $true
            SMTPServer = $smtpServer
            From       = $from
            #To         = $to
            To         = $tofinal
            Subject    = $subject
            Body       = $body
            BodyAsHtml = $true
        }

        writeToLog("Sending email")
		
		[System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }
		
		if (-not [string]::IsNullOrWhiteSpace($to)) {
            Send-MailMessage @splat
            writeToLog("Password set and email sent to $to for account $nativeIdentity.")
        }
        else {
            writeToLog("Manager email is null or empty. Email not sent.")
        }
 
        
    }

