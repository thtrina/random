        $subject = "Active Directory account password for your new hire $displayName"
        $splat = @{
            UseSsl     = $true
            SMTPServer = $smtpServer
            From       = $from
            To         = $tofinal
            Subject    = $subject
            Body       = $body
            BodyAsHtml = $true
        }

        writeToLog("Sending email")
        [System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }
        if($tofinal){
