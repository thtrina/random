$maxRetries = 6
$retry = 0
$found = $false

while (-not $found -and $retry -lt $maxRetries) {

    try {

        $user = Get-ADUser `
            -Identity $sAMAccountName `
            -ErrorAction Stop

        $found = $true
    }
    catch {

        $retry++

        Start-Sleep -Seconds 10
    }
}

if (-not $found) {
    throw "User $sAMAccountName was not found after waiting for AD replication."
}
