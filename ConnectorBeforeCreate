void outErrorLog(String level, String msg) {

    System.out.println(
        new Date() + " : " + level + " : " + msg
    );
}


// ---------------------------------------------------------------
// Start ConnectorBeforeCreate Rule
// ---------------------------------------------------------------

outErrorLog(
    "INFO",
    "Starting ConnectorBeforeCreate Rule"
);


// ---------------------------------------------------------------
// Get the SailPoint AccountRequest
// ---------------------------------------------------------------

// In a native IdentityIQ BeanShell rule,
// the AccountRequest is available directly.

AccountRequest requestObject = accountRequest;


// ---------------------------------------------------------------
// Log the original request
// ---------------------------------------------------------------

if (requestObject != null) {

    outErrorLog(
        "INFO",
        "Request Object: [" + requestObject.toXml() + "]"
    );

} else {

    outErrorLog(
        "ERROR",
        "AccountRequest is null"
    );

    return;
}


// ---------------------------------------------------------------
// Specify the Domain
// ---------------------------------------------------------------

String domain = "mycompany.com";

outErrorLog(
    "INFO",
    "Getting a domain controller from domain [" + domain + "]"
);


// ---------------------------------------------------------------
// Get Domain Controller
// ---------------------------------------------------------------
//
// IMPORTANT:
// This is where your original PowerShell did:
//
// Get-ADDomainController
//     -DomainName $domain
//     -Discover
//
// Native BeanShell/Java does not have the PowerShell
// Get-ADDomainController cmdlet.
//
// If you want a specific DC, simply specify it here.
// ---------------------------------------------------------------

String hostname = "DC3PMEXAPP01.mycompany.com";

outErrorLog(
    "INFO",
    "Domain Controller returned [" + hostname + "]"
);


// ---------------------------------------------------------------
// Add preferredServer attribute
// ---------------------------------------------------------------

try {

    requestObject.addAttribute(
        "preferredServer",
        hostname
    );

    outErrorLog(
        "INFO",
        "Added preferredServer [" + hostname + "]"
    );

}
catch (Exception e) {

    outErrorLog(
        "ERROR",
        "Error adding preferredServer: " + e.getMessage()
    );
}


// ---------------------------------------------------------------
// Add DomainController attribute
// ---------------------------------------------------------------

try {

    AttributeRequest attrDomainController =
        new AttributeRequest();

    attrDomainController.setName(
        "DomainController"
    );

    attrDomainController.setValue(
        hostname
    );

    attrDomainController.setOperation(
        AttributeRequest.Operation.Add
    );

    requestObject.add(
        attrDomainController
    );

    outErrorLog(
        "INFO",
        "Added DomainController [" + hostname + "]"
    );

}
catch (Exception e) {

    outErrorLog(
        "ERROR",
        "Error adding DomainController: "
        + e.getMessage()
    );
}


// ---------------------------------------------------------------
// Log modified request
// ---------------------------------------------------------------

String modifiedRequestObjectXml =
    requestObject.toXml();

outErrorLog(
    "INFO",
    "Modified Request Object: ["
    + modifiedRequestObjectXml
    + "]"
);


// ---------------------------------------------------------------
// Return modified AccountRequest
// ---------------------------------------------------------------

return requestObject;
