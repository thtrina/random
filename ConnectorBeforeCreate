);


// ---------------------------------------------------------------
// Add preferredServer directly to AccountRequest
// ---------------------------------------------------------------

try {

    requestObject.addAttribute(
        "preferredServer",
        hostname
    );

    System.out.println(
        "Added preferredServer [" + hostname + "]"
    );

}
catch (Exception e) {

    System.out.println(
        "ERROR adding preferredServer: "
        + e.getMessage()
    );
}


// ---------------------------------------------------------------
// If you also want DomainController
// ---------------------------------------------------------------

AttributeRequest attrDomainController =
    new AttributeRequest();

attrDomainController.setName("DomainController");

attrDomainController.setValue(hostname);

// Depending on your SailPoint version/API,
// this would use the appropriate operation value.

requestObject.add(attrDomainController);


// ---------------------------------------------------------------
// Return the modified AccountRequest
// ---------------------------------------------------------------

return requestObject;
