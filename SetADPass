# ------------------------------------------------------------------
# Log directory
# ------------------------------------------------------------------

Function writeToLog() {
    param([string]$message)
    Add-Content ($(Get-Date -format "yyyy-MM-dd HH:mm:ss") + " : $($gs) : v$($version) : afterCreate : $($message)") -Path $logFile
}

"========== AD_AfterCreate START ==========" | Out-File $logFile

"Args.Count = $($args.Count)" | Out-File $logFile -Append

for ($i = 0; $i -lt $args.Count; $i++) {
    "args[$i] = [$($args[$i])]" | Out-File $logFile -Append
}

"env:Request = [$env:Request]" | Out-File $logFile -Append
