            writeToLog("SUCCESS: Remote routing address verified.")
        }
        else {
            writeToLog("WARNING: Remote routing address does not match expected value.")
            writeToLog("Expected: $($remoteAddress)")
            writeToLog("Actual: $($checkMailbox.RemoteRoutingAddress)")
        }

        # --------------------------------------------------------------
        # Verify archive
        #
        # ArchiveStatus may not immediately be Active.
        # Therefore, don't automatically treat Pending as a failure.
        # --------------------------------------------------------------
        if ($checkMailbox.ArchiveStatus -eq "Active") {

            writeToLog("SUCCESS: Archive is ACTIVE.")

