        writeToLog("ERROR: $($_.Exception.Message)")

        if ($Session) {
            Remove-PSSession $Session -ErrorAction SilentlyContinue
        }

        throw
    }


    # ------------------------------------------------------------------
    # Close Exchange PowerShell session
    # ------------------------------------------------------------------
    if ($Session) {

        writeToLog("Closing Exchange PowerShell session.")

        Remove-PSSession $Session -ErrorAction SilentlyContinue

        writeToLog("Exchange PowerShell session closed.")
    }


    # ------------------------------------------------------------------
    # Final mailbox status
    # ------------------------------------------------------------------
    if ($mailboxCreated -and $mailboxVerified) {

        writeToLog("======================================================")
        writeToLog("REMOTE MAILBOX PROVISIONING SUCCESSFUL")
        writeToLog("Account: $($sAMAccountName)")
        writeToLog("Email: $($emailAddress)")
        writeToLog("======================================================")

