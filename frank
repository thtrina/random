
$startDate = (Get-Date).AddDays(-30)

$events = Get-WinEvent -FilterHashtable @{
    LogName   = "MSExchange Management"
    StartTime = $startDate
} | Where-Object {
    $_.Message -like "*Enable-RemoteMailbox*"
}

$results = foreach ($event in $events) {

    $values = @($event.Properties | ForEach-Object { $_.Value })

    [PSCustomObject]@{
        TimeCreated = $event.TimeCreated
        EventId     = $event.Id
        Level       = $event.LevelDisplayName
        Machine     = $event.MachineName
        RecordId    = $event.RecordId
        Message     = ($event.Message -replace "`r|`n", " ")
        Properties  = ($values -join " | ")
    }
}

$results |
    Sort-Object TimeCreated |
    Export-Csv "C:\Temp\Enable-RemoteMailbox-Last30Days.csv" -NoTypeInformation -Encoding UTF8


