// using employee status
// note: this may cause issues with accounts that are not connected to a human
String emplStatus = identity.getAttribute("employeeStatus");
if (emplStatus != null) {
    if (emplStatus.equals("A")) {
        return true;
    } else {
        return false;
    }
} else {
    // if there's no employee status then assume that the account should be inactive
    // see note above
    return false;
}
