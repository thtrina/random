# ------------------------------------------------------------------
# Write to employee-specific log
# ------------------------------------------------------------------

function writeToLog {

    param(
        [Parameter(Mandatory = $false)]
        [AllowEmptyString()]
        [string]$message
    )


    # --------------------------------------------------------------
    # If sAMAccountName has not been identified yet, use a temporary
    # log file.
    # --------------------------------------------------------------

    if ([string]::IsNullOrWhiteSpace($script:logFile)) {

        $currentLogFile = Join-Path `
            $script:logDirectory `
            "UNKNOWN_EMPLOYEE.log"

    }
    else {

        $currentLogFile = $script:logFile

    }




    # --------------------------------------------------------------
    # Timestamp
    # --------------------------------------------------------------

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"


    # --------------------------------------------------------------
    # Log message
    # --------------------------------------------------------------

    $logMessage = "$timestamp : v$($script:version) : $message"


    Add-Content `
        -Path $currentLogFile `
        -Value $logMessage
}
function Set-EmployeeLogFile {

    param(
        [Parameter(Mandatory = $true)]
        [string]$EmployeeID
    )

    # Remove characters that are not valid in Windows filenames
    $safeEmployeeID = $EmployeeID -replace '[\\/:*?"<>|]', '_'

    # Get current date in yyyy-MM-dd format
    $logDate = Get-Date -Format "yyyy-MM-dd"

    # Build employee-specific log filename   
    $logFileName = "$logDate.afterprovisioning.EXCHANGE.$safeEmployeeID.txt"

    # Build complete path
    $script:logFile = Join-Path `
        $script:logDirectory `
        $logFileName

    writeToLog("======================================================")
    writeToLog("Starting After Create provisioning script")
    writeToLog("EmployeeID / sAMAccountName: $EmployeeID")
    writeToLog("Log File: $($script:logFile)")
    writeToLog("======================================================")
}
# ------------------------------------------------------------------
# Get attribute value from SailPoint AccountRequest
# ------------------------------------------------------------------

function Get-AttributeValueFromAccountRequest {

    param(
        [SailPoint.Utils.objects.AccountRequest]$request,
        [string]$targetAttribute
    )


    $value = $null


    if ($request) {

        foreach ($attrib in $request.AttributeRequests) {

            if ($attrib.Name -eq $targetAttribute) {

                $value = $attrib.Value

                break
            }
        }

    }
    else {

        writeToLog("ERROR: Account request object was null.")

    }


    return $value
}


