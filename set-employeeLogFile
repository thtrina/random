# --------------------------------------------------------------
# Logging function
# --------------------------------------------------------------

function writeToLog {

    param(
        [Parameter(Mandatory = $false)]
        [AllowEmptyString()]
        [string]$message
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    $logMessage = "$timestamp : v$version : $message"

    Add-Content `
        -Path $script:logFile `
        -Value $logMessage
}


# --------------------------------------------------------------
# Create employee-specific log file
# --------------------------------------------------------------

function Set-EmployeeLogFile {

    param(
        [Parameter(Mandatory = $true)]
        [string]$EmployeeID
    )

    $safeEmployeeID = $EmployeeID -replace '[\\/:*?"<>|]', '_'

    $logDate = Get-Date -Format "yyyy-MM-dd"

    $logFileName = "$logDate.afterprovisioning.$safeEmployeeID.txt"

    $script:logFile = Join-Path `
        $script:logDirectory `
        $logFileName
}


