    -EndDate (Get-Date)

Get-WinEvent -LogName Security |
Where-Object {$_.TimeCreated -ge (Get-Date).AddHours(-24)}


$since = (Get-Date).AddHours(-24)

Get-ADUser -Filter * `
    -Properties whenChanged,mail,mailNickname,targetAddress,msExchRemoteRecipientType |
Where-Object {
    $_.whenChanged -ge $since -and
    $_.msExchRemoteRecipientType
} |
Select-Object Name,
              SamAccountName,
              whenChanged,
              @{Name="Alias";Expression={$_.mailNickname}},
              @{Name="PrimarySMTP";Expression={$_.mail}},
              @{Name="RemoteRoutingAddress";Expression={$_.targetAddress}},
              msExchRemoteRecipientType |
Sort-Object whenChanged -Descending

foreach ($user in $results) {

    Write-Host "=================================="
    Write-Host "Name: $($user.Name)"
