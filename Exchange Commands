    Write-Host "Alias: $($user.Alias)"
    Write-Host "Primary SMTP: $($user.PrimarySMTP)"
    Write-Host "Remote Routing: $($user.RemoteRoutingAddress)"
    Write-Host "RemoteRecipientType: $($user.msExchRemoteRecipientType)"
}


